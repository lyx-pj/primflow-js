{
  "name": "@lyx-pj/primflow-canvas",
  "version": "1.1.0",
  "private": false,
  "description": "JointJS and lit-html canvas for editing and displaying Primflow graphs and execution results.",
  "type": "module",
  "files": [
    "build/**/*",
    "README.md",
    "README.zh-CN.md",
    "docs/**/*.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "@lyx-pj/source": "./src/index.ts",
      "types": "./build/types/index.d.ts",
      "import": "./build/index.mjs",
      "default": "./build/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "pnpm run clean && concurrently 'rolldown -c rolldown.config.ts' 'tsc -b tsconfig.json'",
    "dev": "concurrently 'rolldown -c rolldown.config.ts --watch' 'tsc -b tsconfig.json --watch'",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run --reporter verbose --passWithNoTests",
    "lint": "oxlint --config ../../.oxlintrc.json --deny-warnings ."
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@joint/core": "^4.1.3",
    "@lezer/highlight": "^1.2.5",
    "@lyx-pj/primflow-model": "workspace:*",
    "lit-html": "^3.3.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "rolldown": "1.0.0-beta.32"
  },
  "keywords": [
    "workflow",
    "flow",
    "editor",
    "canvas",
    "graph",
    "node-based",
    "diagram"
  ]
}