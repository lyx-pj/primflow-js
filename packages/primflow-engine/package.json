{
  "name": "@lyx-pj/primflow-engine",
  "version": "1.1.0",
  "private": false,
  "description": "Environment-agnostic workflow execution engine for Primflow: runs graphs, manages events, tasks, loops and node lifecycles without DOM or host-specific APIs.",
  "type": "module",
  "files": [
    "build/**/*",
    "README.md",
    "README.zh-CN.md",
    "docs/**/*.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "@lyx-pj/source": "./src/index.ts",
      "types": "./build/types/index.d.ts",
      "import": "./build/index.mjs",
      "default": "./build/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "pnpm run clean && concurrently 'rolldown -c rolldown.config.ts' 'tsc -b tsconfig.json'",
    "dev": "concurrently 'rolldown -c rolldown.config.ts --watch' 'tsc -b tsconfig.json --watch'",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.tests.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run --reporter verbose --passWithNoTests",
    "lint": "oxlint --config ../../.oxlintrc.json --deny-warnings ."
  },
  "dependencies": {
    "@lyx-pj/primflow-model": "workspace:*"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "rolldown": "1.0.0-beta.32"
  },
  "keywords": [
    "workflow",
    "orchestration",
    "execution",
    "pipeline",
    "engine",
    "environment-agnostic",
    "isomorphic"
  ]
}