{
  "name": "@lyx-pj/primflow-react",
  "private": false,
  "version": "0.0.6",
  "type": "module",
  "main": "build/index.es.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "@lyx-pj/source": "./src/index.ts",
      "types": "./build/index.d.ts",
      "import": "./build/index.es.js",
      "default": "./build/index.es.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build/**/*",
    "README.md",
    "README.zh-CN.md",
    "docs/**/*.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "clean": "rimraf build",
    "lint": "oxlint --config ../../.oxlintrc.json --deny-warnings .",
    "test": "vitest run --reporter verbose"
  },
  "peerDependencies": {
    "@lyx-pj/primflow-canvas": "workspace:*",
    "@lyx-pj/primflow-engine": "workspace:*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@lyx-pj/primflow-canvas": "workspace:*",
    "@lyx-pj/primflow-engine": "workspace:*",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react-swc": "^4.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.5",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^4.5.4"
  },
  "keywords": [
    "workflow",
    "react",
    "flow",
    "orchestration",
    "node-based",
    "visual-programming",
    "pipeline",
    "automation",
    "graph",
    "editor",
    "ui"
  ]
}