#!/usr/bin/env sh

# Husky 使用 sh 启动钩子，显式交给 Bash 执行数组和进程替换语法。
bash -e <<'BASH'

JS_FILES=()
# 保留 NUL 分隔，避免带空格的文件名被拆开；删除的文件不参与检查。
while IFS= read -r -d '' file; do
  case "$file" in
    *.js|*.jsx|*.ts|*.tsx|*.mjs|*.cjs) JS_FILES+=("$file") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ "${#JS_FILES[@]}" -gt 0 ]; then
  pnpm exec oxlint --config .oxlintrc.json --deny-warnings --no-error-on-unmatched-pattern --fix "${JS_FILES[@]}"
fi

while IFS= read -r pkg; do
  PKG_JSON="$pkg/package.json"
  if [ -f "$PKG_JSON" ]; then
    PKG_NAME=$(jq -r '.name' "$PKG_JSON")
    HAS_TEST=$(jq -r '.scripts.test // empty' "$PKG_JSON")
    if [ -n "$PKG_NAME" ] && [ -n "$HAS_TEST" ]; then
      pnpm --filter "$PKG_NAME" test
    fi
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR | awk -F/ '/^(packages|examples)\// {print $1 "/" $2}' | sort -u)
BASH
