{
  "name": "primflow",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "dev": "pnpm --filter primflow-react-example dev",
    "dev:dist": "pnpm --filter './packages/*' build && concurrently -k -n model,engine,canvas,react,app -c blue,cyan,green,magenta,yellow \"pnpm --filter @lyx-pj/primflow-model dev\" \"pnpm --filter @lyx-pj/primflow-engine dev\" \"pnpm --filter @lyx-pj/primflow-canvas dev\" \"pnpm --filter @lyx-pj/primflow-react dev\" \"pnpm --filter primflow-react-example dev:dist\"",
    "build": "pnpm --filter './packages/*' build && pnpm run verify",
    "build:all": "pnpm -r run build",
    "verify": "node scripts/verify-boundaries.mjs",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm test:release && pnpm -r run test && pnpm test:e2e",
    "test:e2e": "playwright test",
    "test:release": "vitest run scripts/release.test.ts",
    "clean": "pnpm -r run clean",
    "sync-versions": "tsx scripts/sync-versions.ts",
    "release": "tsx scripts/release.ts",
    "version": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "format": "prettier --write --ignore-path .gitignore .",
    "format:check": "prettier --check --ignore-path .gitignore ."
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "conventional-changelog-cli": "^5.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "npm:rolldown-vite@latest",
    "vitest": "^3.2.4"
  }
}
